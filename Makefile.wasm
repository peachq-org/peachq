# WebAssembly build (browser q REPL) -> build/wasm/www/, a directory a static server can serve:
# peachq.js/.wasm, the Worker + client + reference page, and files/ + files.json (examples/q).
# Activate emscripten first: . ~/emsdk/emsdk_env.sh && make -f Makefile.wasm wasm

CC  = emcc
CXX = em++
AR  = emar
STD = c17
# Objects under a root of their own: a wasm object and a native object of the
# same TU must never claim one path. Set BEFORE the include, so every rule the
# root Makefile defines is read at this root.
BUILD_DIR = build/wasm

# The source set, the codegen, and the object/archive rules; below is only how
# the BROWSER build differs.
include Makefile
.DEFAULT_GOAL := wasm

# ipc.c is the TCP server: uncompilable under the wasm sysroot, unreachable from
# the q eval path. wasm/ipc_stub.c satisfies the symbols the retained TUs need.
# libffi goes with it — its config headers are generated per NATIVE target, and
# without RAY_FFI q_ffi.c is already the 'nyi stub.
LIB_SRC  = $(filter-out src/core/ipc.c, $(RAY_LIB_SRC))
GLUE_SRC = wasm/q_wasm.c wasm/q_wasm_http.c wasm/q_wasm_shell.c wasm/ipc_stub.c
SRC      = $(LIB_SRC) $(GLUE_SRC) $(filter-out third_party/libffi/%,$(RAY_VENDOR_SRC))
QFFI_DEF =

TARGET = peachq
OUTDIR = $(BUILD_DIR)/www
WEB_SRC = wasm/index.html wasm/engine.js wasm/worker.js wasm/peachq-client.js

INCLUDES = $(RAY_INCLUDES)
RAY_VERSION ?= $(shell cat VERSION 2>/dev/null || echo 0.0)
V_MAJ := $(word 1,$(subst ., ,$(RAY_VERSION)))
V_MIN := $(word 2,$(subst ., ,$(RAY_VERSION)))
V_PAT := $(word 3,$(subst ., ,$(RAY_VERSION)))
V_PAT := $(if $(V_PAT),$(V_PAT),0)
BUILD_DATE := $(shell date -u +%Y-%m-%d)
DEFS = -DRAYFORCE_GIT_COMMIT=\"wasm\" -DRAYFORCE_BUILD_DATE=\"$(BUILD_DATE)\" \
       -DRAY_VERSION_MAJOR=$(V_MAJ) -DRAY_VERSION_MINOR=$(V_MIN) -DRAY_VERSION_PATCH=$(V_PAT) \
       -DRAYFORCE_VERSION=\"$(RAY_VERSION)\"

# -ffinite-math-only is DELIBERATELY absent: the engine encodes float nulls as
# NaN (`x != x`), so assuming NaNs never occur would mis-evaluate 0Nf.
CFLAGS = -Wall -std=$(STD) -O3 -msimd128 \
  -fassociative-math -ftree-vectorize -fno-math-errno \
  -funsafe-math-optimizations -funroll-loops

# RE2 and fmt are the tree's C++, and clang rejects -std=c17 on C++ input: the C
# and the C++ compile separately (the root Makefile's own rules, through $(CXX))
# and the LINK is em++, which is what brings libc++ in. No -fPIC — nothing here
# is a shared object.
RE2_CXXFLAGS = -std=c++17 -O3 -msimd128 -fvisibility=hidden -Ithird_party/re2 -Isrc
FMT_CXXFLAGS = -std=c++17 -O3 -msimd128 -fvisibility=hidden \
               -Ithird_party/fmt/include -Ithird_party/fmt/stub -Isrc

WASM_OBJ = $(addprefix $(BUILD_DIR)/,$(SRC:.c=.o))

# wasm/engine.js is the one caller of the ABI, and marshals a line through malloc (ccall's
# stack copy would cap its length); q_wasm_http.c's EM_JS uses the UTF8/HEAP helpers.
# MODULARIZE emits a createPeachQ factory that loads in a Worker and in Node.
#   STACK_SIZE              — a native thread's 8 MB, not emscripten's 64 KB: the engine keeps
#                             sort/format scratch on the stack, and a `\l` nests deeper still.
#   --no-entry              — the glue has no main(); runtime inits lazily.
EMFLAGS = \
  -s "EXPORTED_FUNCTIONS=['_q_wasm_init','_q_wasm_eval','_q_wasm_qdoc','_malloc','_free']" \
  -s "EXPORTED_RUNTIME_METHODS=['ccall','UTF8ToString','HEAPU8','HEAPU32','FS']" \
  -s ALLOW_MEMORY_GROWTH=1 \
  -s STACK_SIZE=8MB \
  -s MODULARIZE=1 \
  -s EXPORT_NAME=createPeachQ \
  --no-entry

# The page, Worker and client are copied, and examples/q (bar the terminal games) is
# re-staged with its manifest, on every run: both are cheap, and a stale copy is not.
wasm: $(OUTDIR)/$(TARGET).js
	cp $(WEB_SRC) $(OUTDIR)/
	sh wasm/gen-files.sh examples/q $(OUTDIR)

$(OUTDIR)/$(TARGET).js: $(WASM_OBJ) $(RE2_LIB) $(FMT_LIB)
	@mkdir -p $(OUTDIR)
	$(CXX) -O3 -o $@ $(WASM_OBJ) $(RE2_LIB) $(FMT_LIB) $(EMFLAGS)

# The emscripten glue uses syntax a pre-v18 node cannot parse; emsdk_env.sh
# exports its own node as EMSDK_NODE.
NODE ?= $(if $(EMSDK_NODE),$(EMSDK_NODE),node)

wasm-smoke: wasm
	$(NODE) wasm/smoke.js $(OUTDIR)

# Headless Chromium through the Worker; Playwright comes from the environment (PLAYWRIGHT=
# a node_modules dir, or NODE_PATH), and its absence is a skip — this repo installs no packages.
wasm-browser-smoke: wasm
	$(NODE) wasm/browser-smoke.cjs $(OUTDIR) $(PLAYWRIGHT)

clean::
	-rm -rf $(OUTDIR)

.PHONY: wasm wasm-smoke wasm-browser-smoke clean

-include $(WASM_OBJ:.o=.d)
